{
  "name": "befirst-live-archive",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc --noEmit && vite build",
    "test": "vitest run",
    "test:rules": "firebase emulators:exec --project demo-live-archive --only firestore 'vitest run --config vitest.emulator.config.ts'",
    "build:functions": "tsc -p functions/tsconfig.json"
  },
  "dependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "firebase": "^12.0.0",
    "zod": "^4.0.0",
    "lucide-react": "^0.468.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/node": "^24.0.0",
    "typescript": "^5.9.0",
    "vite": "^7.0.0",
    "vitest": "^3.2.0",
    "firebase-tools": "^14.0.0",
    "@firebase/rules-unit-testing": "^5.0.0"
  }
}
